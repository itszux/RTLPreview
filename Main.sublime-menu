[
    {
        "id": "view",
        "children":
        [
            { "caption": "-" },
            {
                "caption": "RTL Preview",
                "children":
                [
                    { "command": "rtl_toggle_view", "caption": "Toggle Preview" }
                ]
            }
        ]
    },
    {
        "id": "preferences",
        "children":
        [
            {
                "caption": "Package Settings",
                "id": "package-settings",
                "children":
                [
                    {
                        "caption": "RTL Preview",
                        "children":
                        [
                            {
                                "command": "edit_settings",
                                "args":
                                {
                                    "base_file": "${packages}/RTLPreview/RTLPreview.sublime-settings",
                                    "default": "{\n\t$0\n}\n"
                                },
                                "caption": "Settings"
                            },
                            {
                                "caption": "-",
                                "id": "key_bindings"
                            },
                            {
                                "command": "edit_settings",
                                "args":
                                {
                                    "base_file": "${packages}/RTLPreview/Default.sublime-keymap",
                                    "default": "[\n\t$0\n]\n"
                                },
                                "caption": "Key Bindings"
                            }
                        ]
                    }
                ]
            }
        ]
    }
]
